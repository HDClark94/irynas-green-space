{% if site.map.enabled %}
  {% assign lat = site.map.lat %}
  {% assign lng = site.map.lng %}
  {% assign zoom = site.map.zoom | default: 14 %}

  {% if site.map.provider == 'osm' %}
    {% assign span = 0.012 %}
    {% assign west = lng | minus: span %}
    {% assign east = lng | plus: span %}
    {% assign south = lat | minus: span %}
    {% assign north = lat | plus: span %}
    {% capture embed_src %}https://www.openstreetmap.org/export/embed.html?bbox={{ west }},{{ south }},{{ east }},{{ north }}&layer=mapnik&marker={{ lat }},{{ lng }}{% endcapture %}
    {% assign provider_name = 'OpenStreetMap' %}
  {% else %}
    {% capture embed_src %}https://maps.google.com/maps?q={{ lat }},{{ lng }}&z={{ zoom }}&output=embed{% endcapture %}
    {% assign provider_name = 'Google Maps' %}
  {% endif %}

  <div class="map-band">
    {% if site.map.heading %}
      <h2 class="map-heading">{{ site.map.heading }}</h2>
    {% endif %}

    {% comment %}
      No iframe in the markup on purpose. consent.js builds one here only after
      a decision - otherwise the embed would have contacted the provider before
      anyone was asked, which is what prior consent forbids.
    {% endcomment %}
    <div
      class="map-frame consent-slot"
      data-consent-src="{{ embed_src }}"
      data-consent-title="Map showing {{ site.map.label | default: site.title }}"
    >
      <div class="consent-slot-note">
        <p>Map loads from {{ provider_name }}, which receives your IP address.</p>
        <button type="button" class="consent-btn consent-slot-load">Show the map</button>
        <p class="consent-slot-alt">
          <a href="https://www.google.com/maps/search/?api=1&query={{ lat }},{{ lng }}">Open in Maps</a>
        </p>
      </div>
    </div>

    {% if site.map.label %}
      <p class="map-meta">{{ site.map.label }}</p>
    {% endif %}
  </div>
{% endif %}
