{% capture footer_body %}
  <div class="footer-grid">
    <div class="footer-col">
      &copy; Copyright {{ site.time | date: '%Y' }}
      {{ site.first_name }}
      {{ site.middle_name }}
      {{ site.last_name }}. {{ site.footer_text }}
      {% if site.impressum_path %}
        <a href="{{ site.url }}{{ site.baseurl }}{{ site.impressum_path }}">Impressum</a>.
      {% endif %}
      {% if site.last_updated %}
        Last updated: {{ 'now' | date: '%B %d, %Y' }}.
      {% endif %}
      <span class="footer-links">
        <a href="{{ '/privacy/' | relative_url }}">Privacy</a>
        <a href="{{ '/terms/' | relative_url }}">Terms</a>
        {% if site.consent.enabled %}
          <a href="#" id="consent-reopen">Cookie settings</a>
        {% endif %}
      </span>
    </div>
    <div class="footer-col footer-col--map">{% include map.liquid %}</div>
  </div>
{% endcapture %}

{% if site.footer_fixed %}
  <footer class="fixed-bottom">
    <div class="container mt-0">{{ footer_body }}</div>
  </footer>
{% else %}
  <footer class="sticky-bottom mt-5">
    <div class="container">{{ footer_body }}</div>
  </footer>
{% endif %}
